---
layout: default
---
{% unless site.data.cv_json %}
  <div class="post">
    <article>
      {% if page.toc_sidebar %}
        <div class="row">
          <!-- Sidebar Navigation-->
          <div class="col-md-3">
            <nav id="cv-sidebar" class="cv-sidebar sticky-top">
              <ul class="nav flex-column">
                {% for entry in site.data.cv %}
                  <li class="nav-item">
                    {% if forloop.first %}
                      <a class="nav-link" href="#{{ entry.title | slugify }}">About</a>
                    {% else %}
                      <a class="nav-link" href="#{{ entry.title | slugify }}">{{ entry.title }}</a>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            </nav>
          </div>
          <!-- Main Content -->
          <div class="col-md-9">
            <div class="cv">
              {% for entry in site.data.cv %}
                <div id="{{ entry.title | slugify }}" class="cv-section">
                  <div class="card mt-3 p-3">
                    {% unless forloop.first %}
                      <h3 class="card-title font-weight-medium">{{ entry.title }}</h3>
                    {% endunless %}
                    <div>
                      {% if entry.type == 'about' %}
                        {% include cv/about.liquid %}
                      {% elsif entry.type == 'list' %}
                        {% include cv/list.liquid %}
                      {% elsif entry.type == 'map' %}
                        {% include cv/map.liquid %}
                      {% elsif entry.type == 'nested_list' %}
                        {% include cv/nested_list.liquid %}
                      {% elsif entry.type == 'time_table' %}
                        {% include cv/time_table.liquid %}
                      {% elsif entry.type == 'list_groups' %}
                        {% include cv/list_groups.liquid %}
                      {% else %}
                        {{ entry.contents }}
                      {% endif %}
                    </div>                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
      {% else %}
        <div class="cv">
          {% for entry in site.data.cv %}
            <a class="anchor" id="{{ entry.title }}"></a>
            <div class="card mt-3 p-3">
              <h3 class="card-title font-weight-medium">{{ entry.title }}</h3>
              <div>
                {% if entry.type == 'about' %}
                  {% include cv/about.liquid %}
                {% elsif entry.type == 'list' %}
                  {% include cv/list.liquid %}
                {% elsif entry.type == 'map' %}
                  {% include cv/map.liquid %}
                {% elsif entry.type == 'nested_list' %}
                  {% include cv/nested_list.liquid %}
                {% elsif entry.type == 'time_table' %}
                  {% include cv/time_table.liquid %}
                {% elsif entry.type == 'list_groups' %}
                  {% include cv/list_groups.liquid %}
                {% else %}
                  {{ entry.contents }}
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </article>
  </div>
{% else %}
  <!-- Legacy JSON CV format (unused) -->
  <div class="post">
    <article>
      <div class="cv">
        {% for data in site.data.cv_json %}
          {% if site.jsoncv and site.jsoncv.size > 0 %}
            {% unless site.jsoncv contains data[0] %}
              {% continue %}
            {% endunless %}
          {% endif %}
          {% if data[0] == 'meta' or data[1].size == 0 %} {% continue %} {% endif %}
          <a class="anchor" id="{{ data[0] }}"></a>
          <div class="card mt-3 p-3">
            {% unless data[0] == 'basics' %}
              <h3 class="card-title font-weight-medium">{{ data[0] | capitalize }}</h3>
            {% endunless %}
            <div>
              {% case data[0] %}
                {% when 'basics' %}
                  {% include resume/basics.liquid %}
                {% when 'education' %}
                  {% include resume/education.liquid %}
                {% when 'work' %}
                  {% include resume/work.liquid %}
                {% when 'volunteer' %}
                  {% include resume/volunteer.liquid %}
                {% when 'projects' %}
                  {% include resume/projects.liquid %}
                {% when 'awards' %}
                  {% include resume/awards.liquid %}
                {% when 'skills' %}
                  {% include resume/skills.liquid %}
                {% when 'publications' %}
                  {% include resume/publications.liquid %}
                {% when 'languages' %}
                  {% include resume/languages.liquid %}
                {% when 'interests' %}
                  {% include resume/interests.liquid %}
                {% when 'certificates' %}
                  {% include resume/certificates.liquid %}
                {% when 'references' %}
                  {% include resume/references.liquid %}
                {% else %}

              {% endcase %}
            </div>
          </div>
        {% endfor %}
      </div>
    </article>
  </div>
{% endunless %}
