---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    {% if page.collection == 'projects' %}<a class="section-back" href="{{ '/research/' | relative_url }}">Research</a>{% endif %}
    <h1 class="post-title">{{ page.title }}</h1>
    {% unless page.hide_title %}{% if page.description %}<p class="post-description">{{ page.description }}</p>{% endif %}{% endunless %}
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
