{% if site.bib_search %}
  <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
  {% comment %}Keep this input on one line: this include is parsed as Markdown on the publications page.{% endcomment %}
  <!-- prettier-ignore -->
  <input type="text" id="bibsearch" spellcheck="false" autocomplete="off" class="search bibsearch-form-input" aria-label="Filter publications" placeholder="Filter by title, author or year">
{% endif %}
